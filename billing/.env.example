# Billing + revenue allocator services — environment variable NAMES only.
# Copy to .env and fill in real values. Never commit real values.

# Stripe secret key (sk_live_... / sk_test_...)
STRIPE_SECRET_KEY=

# SQLite path for the billing transaction log
DATABASE_PATH=

# Required (hardening audit, Oct 2026). Callers of /create-invoice and /transactions
# must send this in the X-API-Key header (or Authorization: Bearer ...).
# If unset or empty, those endpoints return 503 (fail closed).
BILLING_API_KEY=

# Required (hardening audit, Oct 2026). Callers of /allocate/execute must send this
# in the X-API-Key header. Use a different value from BILLING_API_KEY.
# If unset or empty, /allocate/execute returns 503 (fail closed).
ALLOCATOR_API_KEY=

# Stripe Connect destination account IDs for the allocation buckets
STRIPE_DEST_OWNER=
STRIPE_DEST_OPS=
STRIPE_DEST_TAX=
STRIPE_DEST_REINVEST=
