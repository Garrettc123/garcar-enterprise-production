# Generate independent high-entropy values with Python's secrets module. Do not commit credentials.
REOS_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
REOS_APPROVER_KEY=REPLACE_WITH_SEPARATE_32_RANDOM_BYTES
REOS_AGENT_KEY=REPLACE_WITH_SEPARATE_32_RANDOM_BYTES
REOS_DB_PATH=/data/reos.sqlite
REOS_ENABLE_DOCS=0
# Optional; only set after configuring actual signed Stripe webhook delivery
# REOS_STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_REAL_SIGNING_SECRET
