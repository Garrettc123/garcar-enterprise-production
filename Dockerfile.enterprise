FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN groupadd --system app && useradd --system --gid app --home-dir /app app
COPY requirements.enterprise.txt requirements.enterprise.test.txt ./
RUN pip install --no-cache-dir -r requirements.enterprise.txt -r requirements.enterprise.test.txt
COPY enterprise ./enterprise
COPY tests/test_enterprise_fulfillment.py ./tests/test_enterprise_fulfillment.py
RUN python -m compileall -q enterprise tests/test_enterprise_fulfillment.py \
    && python -m unittest discover -s tests -p test_enterprise_fulfillment.py -v
USER app
EXPOSE 8000
CMD ["uvicorn", "enterprise.api:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
